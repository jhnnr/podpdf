# PodPdf Environment Configuration
# Copy this file to .env for local or container deployment:
#   cp .example.env .env

# Host Port Mapping (maps external host port to hardened container port 8080)
HOST_PORT=8080

# Maximum Payload / Upload Ceiling in Bytes (50 MB)
MAX_PAYLOAD_SIZE=52428800

# Security & Authentication (enforces API key requirement when true)
AUTH_ENABLED=true

# Logging Filter (trace, debug, info, warn, error)
RUST_LOG=info

# Custom HTTP Response Headers (semicolon-separated Key:Value pairs)
CUSTOM_HEADERS=X-Content-Type-Options:nosniff;X-Frame-Options:DENY
